# Terraform metadata
pipeline/terraform/.terraform

# Logs
src-front-end/logs
src-front-end/*.log
src-front-end/npm-debug.log*
src-front-end/yarn-debug.log*
src-front-end/yarn-error.log*

# Runtime data
src-front-end/pids
src-front-end/*.pid
src-front-end/*.seed
src-front-end/*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
src-front-end/lib-cov

# Coverage directory used by tools like istanbul
src-front-end/coverage

# nyc test coverage
src-front-end/.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
src-front-end/.grunt

# Bower dependency directory (https://bower.io/)
src-front-end/bower_components

# node-waf configuration
src-front-end/.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
src-front-end/build/Release

# Dependency directories
src-front-end/node_modules/
src-front-end/jspm_packages/

# Typescript v1 declaration files
src-front-end/typings/

# Optional npm cache directory
src-front-end/.npm

# Optional eslint cache
src-front-end/.eslintcache

# Optional REPL history
src-front-end/.node_repl_history

# Output of 'npm pack'
src-front-end/*.tgz

# dotenv environment variables file
src-front-end/.env

# gatsby files
src-front-end/.cache/
src-front-end/public

# Mac files
.DS_Store

# Yarn
yarn-error.log
.pnp/
.pnp.js
# Yarn Integrity file
.yarn-integrity

# NPM
package-lock.json

tags*

# IntelliJ
.idea
*.iml